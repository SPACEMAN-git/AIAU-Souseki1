# Frontend-safe variables only. Never put secret keys here.
# Leave Supabase vars empty to run fully offline in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# true = always use the bundled demo data / demo commute estimator.
VITE_DEMO_MODE=true

# Server-only secrets (set as Supabase Edge Function secrets, NOT here):
#   supabase secrets set NAVITIME_API_KEY=...
#   supabase secrets set ORS_API_KEY=...
