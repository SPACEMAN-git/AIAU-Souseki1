# Supabase（前端用，RLS 匿名只读）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 注意：RapidAPI key 不放在前端环境变量中。
# 通过 `supabase secrets set RAPIDAPI_KEY=<key>` 配置到 Edge Functions。

# navitime-proxy 的地址（可选）。
# 默认使用 ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1/navitime-proxy。
# 本地用 deno/supabase CLI serve 函数时可覆盖，例如 http://localhost:8000
# NEXT_PUBLIC_NAVITIME_PROXY_URL=

# 设为 1 时所有 navitime-proxy 请求附加 mock=1（无 RapidAPI key 也能走通全流程）
# NEXT_PUBLIC_NAVITIME_MOCK=1
